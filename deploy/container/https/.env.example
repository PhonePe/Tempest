# Use a reviewed nginx image with the HTTP SSL module and OpenSSL TLS 1.3.
# Copy this template to a root-owned deployment environment file.
TEMPEST_TLS_IMAGE=docker.io/library/nginx@sha256:REPLACE_WITH_REVIEWED_DIGEST
TEMPEST_TLS_CONFIG=/etc/tempest/https/nginx.conf
TEMPEST_TLS_DIR=/etc/tempest/tls
