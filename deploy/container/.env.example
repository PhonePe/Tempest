# Compose interpolation only. Keep runtime secrets in TEMPEST_ENV_FILE.
TEMPEST_IMAGE=registry.example.invalid/tempest:0.1.0
TEMPEST_ENV_FILE=/etc/tempest/tempest.env
TEMPEST_L2_CONFIG=/etc/tempest/tempest-l2.toml
TEMPEST_L3_CONFIG=/etc/tempest/tempest-l3.toml
TEMPEST_ARTIFACT_ROOT=/tftpboot
TEMPEST_L2_AUDIT_DIR=/var/log/tempest/l2
TEMPEST_L3_AUDIT_DIR=/var/log/tempest/l3

# The examples reserve one worker for the compatibility L2 plane and five for
# the preferred routed plane on a six-vCPU host. Match listener_shards in each
# TOML file to these values, then retune from measurements on the target host.
TEMPEST_L2_WORKER_THREADS=1
TEMPEST_L3_WORKER_THREADS=5

TEMPEST_NOFILE_SOFT=65536
TEMPEST_NOFILE_HARD=65536
TEMPEST_STOP_GRACE_PERIOD=45s
