# Editor-neutral whitespace settings (https://editorconfig.org). Rust formatting
# is owned by rustfmt.toml and checked with `cargo fmt --all -- --check`.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,sls,jinja}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
